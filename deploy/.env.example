# Compose variables for /opt/obh/compose.yml. Written by deploy.sh; the
# database password is generated once and must not change afterwards.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Image tags pinned by deploy.sh (full commit sha, or latest before the first
# deploy). Do not edit by hand during normal operation.
WEB_TAG=latest
DOCS_TAG=latest
WEB_PREVIOUS_TAG=
DOCS_PREVIOUS_TAG=

# Certificate issuance for obhco.ir (empty pauses it; the default is
# obhco.ir). Only leave it empty while the DNS A record does not point here,
# otherwise the companion retries against Let's Encrypt's rate limit.
LETSENCRYPT_HOST=obhco.ir
