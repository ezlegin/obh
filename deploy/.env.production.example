# Runtime secrets for /opt/obh/.env.production (read by the web and docs
# containers). Never commit the real file. See apps/web/.env.example.

# PostgreSQL inside the compose network. Keep the password in sync with
# POSTGRES_PASSWORD in /opt/obh/.env.
DATABASE_URL="postgresql://obh:CHANGE_ME@db:5432/obh?schema=public"

# Auth.js session signing key and webhook-secret encryption key. Generate:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# Public origin used for payment return URLs and absolute links.
APP_URL="https://obhco.ir"
NEXT_PUBLIC_APP_URL="https://obhco.ir"
NEXT_PUBLIC_DOCS_URL="https://obhco.ir/docs"

NODE_ENV=production

# Initial manager account, used only when bootstrapping (deploy/README.md).
# Remove ADMIN_PASSWORD after the account exists.
ADMIN_EMAIL=""
ADMIN_NAME="OBH Manager"
ADMIN_PASSWORD=""

# Private directory for expense documents (mounted volume).
EXPENSE_DOCUMENT_DIR="/app/storage/expense-documents"

# Sadad (Bank Melli Iran) gateway. Leave empty to keep live payments off.
SADAD_MERCHANT_ID=""
SADAD_TERMINAL_ID=""
SADAD_TERMINAL_KEY=""
SADAD_BASE_URL="https://sadad.shaparak.ir"

# Digipay installment gateway. Leave empty to keep live Digipay off.
DIGIPAY_USERNAME=""
DIGIPAY_PASSWORD=""
DIGIPAY_CLIENT_ID=""
DIGIPAY_CLIENT_SECRET=""
DIGIPAY_BASE_URL="https://api.mydigipay.com/digipay/api"

# Optional Cloudinary storage for expense references.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# CLOUDINARY_EXPENSE_FOLDER="obh/expense-documents"
