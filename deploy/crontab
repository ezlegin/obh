# Installed as /etc/cron.d/obh. The database is dumped nightly to
# /opt/obh/backups. Webhook retries run inside the web container
# (apps/web/instrumentation.ts).
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

30 0 * * * root /opt/obh/backup.sh >> /var/log/obh.log 2>&1
