{
  "name": "obh",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "pnpm --filter web dev --port 3100",
    "dev:docs": "pnpm --filter docs dev --port 3200",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "pnpm --filter @obhco/payments build && pnpm --filter web test:integration",
    "webhooks:process": "pnpm --filter web webhooks:process",
    "db:generate": "pnpm --filter web db:generate",
    "db:validate": "pnpm --filter web db:validate",
    "db:push": "pnpm --filter web db:push",
    "db:studio": "pnpm --filter web db:studio",
    "auth:create-manager": "pnpm --filter web auth:create-manager",
    "auth:reset-manager": "pnpm --filter web auth:reset-manager",
    "db:ensure": "pnpm --filter web db:ensure"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
