# PostgreSQL connection string. Replace the placeholder values.
DATABASE_URL="postgresql://obh_dev_user:change_me@127.0.0.1:5432/obh_dev?schema=public"

# Auth.js session encryption secret. Also derives the encryption key for
# stored service credentials. Generate a new value:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# Public origin of this app, used for absolute links. Defaults to
# http://localhost:3100 in local dev.
APP_URL="https://obhco.ir"

# OBH does not process payments. Each service takes payments with its own
# gateway terminal (@obhco/pay) and reports to OBH. Gateway credentials
# (SADAD_*, ZARINPAL_*, BEHPARDAKHT_*, DIGIPAY_*) belong in the *service's*
# environment, not here. Create the service key in Admin -> Services.

# Optional local directory for private expense document storage.
# Defaults to apps/web/storage/expense-documents.
# EXPENSE_DOCUMENT_DIR="D:\\private\\obh-expense-documents"

# Cloudinary (optional) for expense reference documents. When all three
# credentials are set, new PDF/image references are uploaded to Cloudinary
# instead of local disk. Keep the secret server-side.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# Optional folder prefix for uploaded expense references.
# Defaults to obh/expense-documents.
# CLOUDINARY_EXPENSE_FOLDER="obh/expense-documents"
