# PostgreSQL connection string. Replace the placeholder values.
DATABASE_URL="postgresql://obh_dev_user:change_me@127.0.0.1:5432/obh_dev?schema=public"

# Auth.js session encryption secret. Also derives the encryption key for
# per-service webhook signing secrets. Generate a new value:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# Public origin used to build Sadad ReturnUrl (/api/v1/sadad/callback) and
# local simulator checkout URLs. Defaults to http://localhost:3100 in local dev.
APP_URL="https://obhco.ir"

# Sadad (Bank Melli Iran) Internet Payment Gateway credentials.
# Keep these strictly server-side; never expose SADAD_TERMINAL_KEY to browsers.
SADAD_MERCHANT_ID=""
SADAD_TERMINAL_ID=""
SADAD_TERMINAL_KEY=""
SADAD_BASE_URL="https://sadad.shaparak.ir"
# Optional relay on an Iranian host (deploy/sadad-relay), for servers outside
# Iran. Both must be set; the browser still goes to SADAD_BASE_URL/Purchase.
SADAD_RELAY_URL=""
SADAD_RELAY_SECRET=""

# Digipay Unified Payment Gateway (installments / BNPL, wallet, card).
# Callback URL: /api/v1/digipay/callback. Leave empty to keep live Digipay off.
# Use https://uat.mydigipay.info/digipay/api for Digipay's staging environment.
DIGIPAY_USERNAME=""
DIGIPAY_PASSWORD=""
# The ready-made "Basic …" header Digipay issues; or set CLIENT_ID + CLIENT_SECRET.
DIGIPAY_AUTHORIZATION=""
DIGIPAY_CLIENT_ID=""
DIGIPAY_CLIENT_SECRET=""
DIGIPAY_BASE_URL="https://api.mydigipay.com/digipay/api"

# Zarinpal payment gateway (full card payments).
# Callback URL: /api/v1/zarinpal/callback. Leave empty to keep live Zarinpal off.
# ZARINPAL_SANDBOX=true sends LIVE payments to sandbox.zarinpal.com.
# (ZARRINPAL_MERCHANT_ID is accepted as an alias.)
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"

# Optional local directory for private expense document storage.
# Defaults to apps/web/storage/expense-documents.
# EXPENSE_DOCUMENT_DIR="D:\\private\\obh-expense-documents"

# Cloudinary (optional) for expense reference documents. When all three
# credentials are set, new PDF/image references are uploaded to Cloudinary
# instead of local disk. Keep the secret server-side.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional folder prefix for uploaded expense references.
# Defaults to obh/expense-documents.
# CLOUDINARY_EXPENSE_FOLDER="obh/expense-documents"
