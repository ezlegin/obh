{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"server/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"types/**/*.d.ts\" \"*.{ts,mjs}\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/payment-lifecycle.test.ts tests/service-credentials.test.ts tests/development-adapter.test.ts tests/accounting-dates.test.ts",
    "test:integration": "tsx --conditions=react-server tests/sdk-integration.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "auth:create-manager": "tsx scripts/create-manager.ts",
    "webhooks:process": "tsx --conditions=react-server scripts/process-webhooks.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@obh/payments": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@workspace/ui": "workspace:*",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.8",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
