// OBH database foundation.
//
// This schema intentionally models financial facts without implementing
// business calculations. See prisma/README.md for the accounting boundaries and
// the rules that still require confirmation before Step 7/8 logic is added.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountKind {
  PROVIDER
  BUSINESS
}

enum ProviderEnvironment {
  TEST
  LIVE
}

enum PaymentDirection {
  INCOMING
  OUTGOING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentEventSource {
  SYSTEM
  SERVICE
  PROVIDER
  MANAGER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum TransferKind {
  INTERNAL
  SETTLEMENT
  WITHDRAWAL
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum FeeKind {
  GATEWAY_FEE
  COMMISSION
}

enum FeeStatus {
  PENDING
  SETTLED
  VOIDED
}

enum ExpenseStatus {
  PENDING
  PAID
  VOIDED
}

enum RecurringExpenseStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  EXHAUSTED
}

enum ProfitPeriodStatus {
  DRAFT
  APPROVED
  CLOSED
  VOIDED
}

enum ProfitDistributionStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum PayoutStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum InstallmentPlanStatus {
  ACTIVE
  SETTLED
  CANCELLED
}

enum InstallmentStatus {
  SCHEDULED
  SETTLED
  CANCELLED
}

/// The authenticated manager account. Authentication is implemented in Step 3;
/// this model only reserves the durable identity and audit relationship.
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique @db.VarChar(320)
  name         String    @db.VarChar(160)
  passwordHash String?   @db.VarChar(255)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  auditLogs                 AuditLog[]
  approvedProfitPeriod      ProfitPeriod[]     @relation("ProfitPeriodApprovedBy")
  approvedRecurringExpenses RecurringExpense[] @relation("RecurringExpenseApprovedBy")
}

/// A product or service that can originate payments through OBH.
model ConnectedService {
  id                     String    @id @default(uuid(7)) @db.Uuid
  slug                   String    @unique @db.VarChar(80)
  name                   String    @db.VarChar(160)
  domain                 String    @unique @db.VarChar(255)
  description            String?   @db.Text
  allowedReturnUrls      String[]  @default([])
  defaultReturnUrl       String?   @db.Text
  webhookUrl             String?   @db.Text
  webhookSecretEncrypted String?   @db.Text
  webhookSecretCreatedAt DateTime? @db.Timestamptz(3)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  credentials        ServiceCredential[]
  payments           Payment[]
  idempotencyRecords PaymentIdempotencyRecord[]
  webhookDeliveries  WebhookDelivery[]
  income             Income[]
  expenses           Expense[]
  recurringExpenses  RecurringExpense[]
  ownershipShares    ServiceOwnershipShare[]
  profitPeriods      ServiceProfitPeriod[]

  @@index([isActive])
}

/// Service-specific shareholder percentages. When a service has rows here,
/// they replace corporation-level ownership for that service's distributions.
/// A service with no rows falls back to OwnershipRecord.
model ServiceOwnershipShare {
  id            String   @id @default(uuid(7)) @db.Uuid
  serviceId     String   @db.Uuid
  shareholderId String   @db.Uuid
  percentage    Decimal  @db.Decimal(7, 4)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  service     ConnectedService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  shareholder Shareholder      @relation(fields: [shareholderId], references: [id], onDelete: Restrict)

  @@unique([serviceId, shareholderId])
  @@index([shareholderId])
}

/// Service API credentials. Both a SHA-256 hash (for fast request
/// authentication) and an AES-256-GCM encrypted copy (so administrators can
/// view or copy the full credential later from the admin console) are stored.
model ServiceCredential {
  id              String              @id @default(uuid(7)) @db.Uuid
  serviceId       String              @db.Uuid
  keyId           String              @unique @db.VarChar(64)
  secretHash      String              @db.VarChar(255)
  secretEncrypted String?             @db.Text
  label           String              @db.VarChar(120)
  environment     ProviderEnvironment @default(TEST)
  lastUsedAt      DateTime?           @db.Timestamptz(3)
  revokedAt       DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  service ConnectedService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId, environment, revokedAt])
}

/// The payment gateway record. OBH offers the gateways defined in code —
/// `sadad` (Bank Melli card payments) and `digipay` (installments / BNPL) —
/// provisioned automatically; they are never created or edited from the admin
/// panel. Credentials are intentionally not stored here; they remain
/// server-side environment values.
model PaymentProvider {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  accounts FinancialAccount[]
  payments Payment[]

  @@index([isActive])
}

/// A real account at a provider or a business-owned account (bank, cash,
/// wallet, etc.). This is not the same thing as a provider or a connected
/// service. `providerId` is expected for PROVIDER accounts and absent for
/// BUSINESS accounts; that rule is enforced by server validation in a later
/// step rather than inferred here.
model FinancialAccount {
  id                String               @id @default(uuid(7)) @db.Uuid
  name              String               @db.VarChar(160)
  kind              AccountKind
  providerId        String?              @db.Uuid
  environment       ProviderEnvironment?
  externalReference String?              @db.VarChar(191)
  institution       String?              @db.VarChar(160)
  maskedIdentifier  String?              @db.VarChar(80)
  currency          String               @default("IRR") @db.VarChar(3)
  openingBalance    Decimal              @default(0) @db.Decimal(24, 2)
  openingBalanceAt  DateTime?            @db.Timestamptz(3)
  isActive          Boolean              @default(true)
  notes             String?              @db.Text
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)

  provider             PaymentProvider?        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  payments             Payment[]               @relation("PaymentProviderAccount")
  fees                 ProviderFee[]
  transfersFrom        Transfer[]              @relation("TransferFromAccount")
  transfersTo          Transfer[]              @relation("TransferToAccount")
  reconciliations      AccountReconciliation[]
  expenses             Expense[]
  income               Income[]
  capitalContributions CapitalContribution[]
  shareholderPayouts   ShareholderPayout[]
  recurringExpenses    RecurringExpense[]

  @@index([kind, isActive])
  @@index([providerId])
}

/// A manual reconciliation snapshot. Balances are otherwise calculated from
/// recorded movements; this table is what lets the UI distinguish an actual
/// reconciled balance from a calculated one.
model AccountReconciliation {
  id                String   @id @default(uuid(7)) @db.Uuid
  accountId         String   @db.Uuid
  asOf              DateTime @db.Timestamptz(3)
  actualBalance     Decimal  @db.Decimal(24, 2)
  calculatedBalance Decimal  @db.Decimal(24, 2)
  difference        Decimal  @db.Decimal(24, 2)
  note              String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, asOf])
}

model PaymentMethod {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  payments Payment[]

  @@index([isActive])
}

/// Authoritative OBH payment record. Gateway callbacks and browser redirects
/// may update this only after server-side Sadad `Verify`.
///
/// Sadad field mapping:
/// - `gatewayOrderId`    → Sadad `OrderId` (numeric, unique per terminal)
/// - `providerSessionId` → Sadad payment `Token`
/// - `providerReference` → Sadad `RetrivalRefNo` (reference number)
/// - `traceNumber`       → Sadad `SystemTraceNo` (tracking number)
///
/// Digipay field mapping:
/// - `gatewayOrderId`    → Digipay `providerId`
/// - `providerSessionId` → Digipay purchase `ticket`
/// - `providerReference` → Digipay `trackingCode`
/// - `traceNumber`       → Digipay `rrn` (IPG purchases only)
model Payment {
  id                 String              @id @default(uuid(7)) @db.Uuid
  reference          String              @unique @db.VarChar(48)
  gatewayOrderId     BigInt              @unique @default(autoincrement())
  serviceId          String?             @db.Uuid
  externalOrderId    String?             @db.VarChar(191)
  idempotencyKey     String?             @db.VarChar(191)
  amount             Decimal             @db.Decimal(24, 2)
  currency           String              @default("IRR") @db.VarChar(3)
  direction          PaymentDirection    @default(INCOMING)
  environment        ProviderEnvironment @default(TEST)
  status             PaymentStatus       @default(PENDING)
  description        String              @db.Text
  metadata           Json?
  providerId         String?             @db.Uuid
  providerAccountId  String?             @db.Uuid
  providerReference  String?             @db.VarChar(191)
  providerSessionId  String?             @db.VarChar(191)
  checkoutUrl        String?             @db.Text
  returnUrl          String?             @db.Text
  requestFingerprint String?             @db.VarChar(64)
  paymentMethodId    String?             @db.Uuid
  traceNumber        String?             @db.VarChar(64)
  maskedCardNumber   String?             @db.VarChar(32)
  gatewayResultCode  Int?
  gatewayResultText  String?             @db.Text
  callbackReceivedAt DateTime?           @db.Timestamptz(3)
  completedAt        DateTime?           @db.Timestamptz(3)
  verifiedAt         DateTime?           @db.Timestamptz(3)
  failedAt           DateTime?           @db.Timestamptz(3)
  cancelledAt        DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  service            ConnectedService?          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  provider           PaymentProvider?           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerAccount    FinancialAccount?          @relation("PaymentProviderAccount", fields: [providerAccountId], references: [id], onDelete: Restrict)
  paymentMethod      PaymentMethod?             @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  events             PaymentEvent[]
  verifications      PaymentVerification[]
  fees               ProviderFee[]
  webhookDeliveries  WebhookDelivery[]
  idempotencyRecords PaymentIdempotencyRecord[]
  installmentPlan    InstallmentPlan?

  @@unique([serviceId, externalOrderId])
  @@unique([serviceId, idempotencyKey])
  @@index([status, createdAt])
  @@index([environment, status, createdAt])
  @@index([serviceId, createdAt])
  @@index([providerAccountId, createdAt])
  @@index([providerReference])
  @@index([providerSessionId])
  @@index([status, callbackReceivedAt])
}

/// Settlement schedule for a verified installment (Digipay BNPL/credit)
/// purchase. The customer pays the first installment at checkout; the gateway
/// deposits each remaining installment on the 7th of the following Iranian
/// (Solar Hijri) months. Only SETTLED installments count toward the provider
/// account balance; SCHEDULED ones are a receivable.
model InstallmentPlan {
  id               String                @id @default(uuid(7)) @db.Uuid
  paymentId        String                @unique @db.Uuid
  totalAmount      Decimal               @db.Decimal(24, 2)
  installmentCount Int
  currency         String                @default("IRR") @db.VarChar(3)
  status           InstallmentPlanStatus @default(ACTIVE)
  /// Gateway purchase type, e.g. `BNPL` or `CREDIT`.
  purchaseType     String?               @db.VarChar(40)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  installments Installment[]

  @@index([status])
}

model Installment {
  id        String            @id @default(uuid(7)) @db.Uuid
  planId    String            @db.Uuid
  sequence  Int
  amount    Decimal           @db.Decimal(24, 2)
  /// Date (Tehran calendar day) the gateway settles this installment.
  dueOn     DateTime          @db.Date
  status    InstallmentStatus @default(SCHEDULED)
  settledAt DateTime?         @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  plan InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sequence])
  @@index([status, dueOn])
}

/// Every consumed service idempotency key, including keys that replay an
/// existing external order. This prevents a key from being reused for a
/// different request after an order-based replay.
model PaymentIdempotencyRecord {
  id                 String   @id @default(uuid(7)) @db.Uuid
  serviceId          String   @db.Uuid
  key                String   @db.VarChar(191)
  paymentId          String   @db.Uuid
  requestFingerprint String   @db.VarChar(64)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  service ConnectedService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payment Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([serviceId, key])
  @@index([paymentId])
}

/// Append-only lifecycle history for a payment. `type` is a controlled string
/// so new event names can be introduced without a destructive enum migration.
model PaymentEvent {
  id             String             @id @default(uuid(7)) @db.Uuid
  paymentId      String             @db.Uuid
  type           String             @db.VarChar(80)
  source         PaymentEventSource
  previousStatus PaymentStatus?
  newStatus      PaymentStatus?
  message        String?            @db.Text
  metadata       Json?
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([type, createdAt])
}

/// Each row is one server-side verification attempt. A redirect is never
/// verification; only a verified row may support an authoritative status.
model PaymentVerification {
  id                String             @id @default(uuid(7)) @db.Uuid
  paymentId         String             @db.Uuid
  status            VerificationStatus
  method            String             @db.VarChar(80)
  providerReference String?            @db.VarChar(191)
  verifiedAt        DateTime?          @db.Timestamptz(3)
  failureReason     String?            @db.Text
  metadata          Json?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

/// Fees charged by a provider. Fees are recorded separately from the gross
/// payment amount so reports do not conflate them.
model ProviderFee {
  id                String    @id @default(uuid(7)) @db.Uuid
  providerAccountId String    @db.Uuid
  paymentId         String?   @db.Uuid
  kind              FeeKind
  status            FeeStatus @default(PENDING)
  amount            Decimal   @db.Decimal(24, 2)
  currency          String    @default("IRR") @db.VarChar(3)
  chargedAt         DateTime  @db.Timestamptz(3)
  reference         String?   @db.VarChar(191)
  note              String?   @db.Text
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  providerAccount FinancialAccount @relation(fields: [providerAccountId], references: [id], onDelete: Restrict)
  payment         Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([providerAccountId, chargedAt])
  @@index([paymentId])
  @@index([status, chargedAt])
}

/// A movement between two financial accounts. Settlements and withdrawals use
/// the same transfer record with an explicit kind.
model Transfer {
  id                String         @id @default(uuid(7)) @db.Uuid
  reference         String         @unique @db.VarChar(48)
  fromAccountId     String         @db.Uuid
  toAccountId       String         @db.Uuid
  amount            Decimal        @db.Decimal(24, 2)
  currency          String         @default("IRR") @db.VarChar(3)
  kind              TransferKind
  status            TransferStatus @default(PENDING)
  occurredAt        DateTime       @db.Timestamptz(3)
  externalReference String?        @db.VarChar(191)
  note              String?        @db.Text
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  fromAccount FinancialAccount @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   FinancialAccount @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([fromAccountId, occurredAt])
  @@index([toAccountId, occurredAt])
  @@index([status, occurredAt])
}

/// Reliable service notification queue. Delivery attempts are recorded here so
/// retries and duplicate callbacks are observable in Step 6.
model WebhookDelivery {
  id            String                @id @default(uuid(7)) @db.Uuid
  serviceId     String                @db.Uuid
  paymentId     String                @db.Uuid
  eventType     String                @db.VarChar(80)
  endpoint      String                @db.Text
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  payload       Json
  lastAttemptAt DateTime?             @db.Timestamptz(3)
  nextAttemptAt DateTime?             @db.Timestamptz(3)
  deliveredAt   DateTime?             @db.Timestamptz(3)
  lastError     String?               @db.Text
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)

  service ConnectedService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payment Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, eventType])
  @@index([status, nextAttemptAt])
  @@index([serviceId, createdAt])
}

model ExpenseCategory {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String   @unique @db.VarChar(120)
  description      String?  @db.Text
  requiresDocument Boolean  @default(false)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@index([isActive, sortOrder])
}

/// Operating costs are accounting records, not simply cash withdrawals. The
/// source account is optional until an expense is marked paid.
model Expense {
  id                 String        @id @default(uuid(7)) @db.Uuid
  categoryId         String        @db.Uuid
  accountId          String?       @db.Uuid
  serviceId          String?       @db.Uuid
  recurringExpenseId String?       @db.Uuid
  amount             Decimal       @db.Decimal(24, 2)
  currency           String        @default("IRR") @db.VarChar(3)
  spentOn            DateTime      @db.Date
  description        String        @db.Text
  notes              String?       @db.Text
  status             ExpenseStatus @default(PENDING)
  paidAt             DateTime?     @db.Timestamptz(3)
  externalReference  String?       @db.VarChar(191)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  category         ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account          FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  service          ConnectedService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: Restrict)
  documents        ExpenseDocument[]

  @@unique([recurringExpenseId, spentOn])
  @@index([spentOn])
  @@index([categoryId, spentOn])
  @@index([accountId, spentOn])
  @@index([serviceId, spentOn])
  @@index([status])
  @@index([recurringExpenseId])
}

/// Metadata for a private supporting document. The file itself belongs in
/// protected object storage; no binary financial document is stored in Postgres.
model ExpenseDocument {
  id             String   @id @default(uuid(7)) @db.Uuid
  expenseId      String   @db.Uuid
  fileName       String   @db.VarChar(255)
  storageKey     String   @unique @db.VarChar(512)
  mimeType       String   @db.VarChar(160)
  byteSize       Int
  checksumSha256 String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@index([expenseId])
}

/// A manager-approved template for repeating operating costs. Approval is an
/// explicit state change; scheduled expenses are generated manually and remain
/// pending until their supporting requirements are satisfied.
model RecurringExpense {
  id            String                 @id @default(uuid(7)) @db.Uuid
  categoryId    String                 @db.Uuid
  accountId     String?                @db.Uuid
  serviceId     String?                @db.Uuid
  amount        Decimal                @db.Decimal(24, 2)
  currency      String                 @default("IRR") @db.VarChar(3)
  description   String                 @db.Text
  frequency     RecurringFrequency
  intervalCount Int                    @default(1)
  startOn       DateTime               @db.Date
  nextDueOn     DateTime               @db.Date
  endOn         DateTime?              @db.Date
  status        RecurringExpenseStatus @default(DRAFT)
  approvedAt    DateTime?              @db.Timestamptz(3)
  approvedById  String?                @db.Uuid
  notes         String?                @db.Text
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(3)

  category   ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account    FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  service    ConnectedService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  approvedBy User?             @relation("RecurringExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  expenses   Expense[]

  @@index([status, nextDueOn])
  @@index([categoryId])
  @@index([serviceId])
}

model Income {
  id                String   @id @default(uuid(7)) @db.Uuid
  accountId         String?  @db.Uuid
  serviceId         String?  @db.Uuid
  amount            Decimal  @db.Decimal(24, 2)
  currency          String   @default("IRR") @db.VarChar(3)
  receivedOn        DateTime @db.Date
  description       String   @db.Text
  source            String?  @db.VarChar(160)
  externalReference String?  @db.VarChar(191)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  account FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  service ConnectedService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([receivedOn])
  @@index([accountId, receivedOn])
  @@index([serviceId, receivedOn])
}

model Shareholder {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(160)
  email     String?  @db.VarChar(320)
  phone     String?  @db.VarChar(40)
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  ownershipRecords       OwnershipRecord[]
  capitalContributions   CapitalContribution[]
  distributions          ProfitDistribution[]
  serviceOwnershipShares ServiceOwnershipShare[]
  serviceDistributions   ServiceProfitDistribution[]

  @@index([isActive])
}

/// Historical ownership. Overlapping active periods are prevented by service
/// validation, not by a database exclusion constraint in this foundation.
model OwnershipRecord {
  id            String    @id @default(uuid(7)) @db.Uuid
  shareholderId String    @db.Uuid
  percentage    Decimal   @db.Decimal(7, 4)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  note          String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Restrict)

  @@index([shareholderId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

/// Capital paid into the corporation by a shareholder. This is equity, never
/// revenue, and is deliberately separate from Income and ProfitDistribution.
model CapitalContribution {
  id                String   @id @default(uuid(7)) @db.Uuid
  shareholderId     String   @db.Uuid
  accountId         String?  @db.Uuid
  amount            Decimal  @db.Decimal(24, 2)
  currency          String   @default("IRR") @db.VarChar(3)
  contributedOn     DateTime @db.Date
  description       String   @db.Text
  externalReference String?  @db.VarChar(191)
  note              String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  shareholder Shareholder       @relation(fields: [shareholderId], references: [id], onDelete: Restrict)
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([shareholderId, contributedOn])
  @@index([accountId, contributedOn])
}

/// A frozen profit-calculation snapshot. Monetary totals remain null until a
/// calculation is intentionally recorded. Distribution rules are not assumed.
model ProfitPeriod {
  id                  String             @id @default(uuid(7)) @db.Uuid
  startsOn            DateTime           @db.Date
  endsOn              DateTime           @db.Date
  currency            String             @default("IRR") @db.VarChar(3)
  status              ProfitPeriodStatus @default(DRAFT)
  totalRevenue        Decimal?           @db.Decimal(24, 2)
  totalExpenses       Decimal?           @db.Decimal(24, 2)
  providerFees        Decimal?           @db.Decimal(24, 2)
  retentionPercentage Decimal?           @default(0) @db.Decimal(7, 4)
  reserveAmount       Decimal?           @db.Decimal(24, 2)
  taxAmount           Decimal?           @db.Decimal(24, 2)
  netProfit           Decimal?           @db.Decimal(24, 2)
  lossBalanceBefore   Decimal?           @db.Decimal(24, 2)
  lossApplied         Decimal?           @db.Decimal(24, 2)
  lossBalanceAfter    Decimal?           @db.Decimal(24, 2)
  distributableAmount Decimal?           @db.Decimal(24, 2)
  unallocatedResidual Decimal?           @db.Decimal(24, 2)
  ownershipTotal      Decimal?           @db.Decimal(7, 4)
  calculatedAt        DateTime?          @db.Timestamptz(3)
  approvedAt          DateTime?          @db.Timestamptz(3)
  approvedById        String?            @db.Uuid
  closedAt            DateTime?          @db.Timestamptz(3)
  notes               String?            @db.Text
  adjustmentNote      String?            @db.Text
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  approvedBy    User?                @relation("ProfitPeriodApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  distributions ProfitDistribution[]

  @@unique([startsOn, endsOn])
  @@index([status, endsOn])
}

/// A single shareholder's allocation for a period. The percentage is snapshotted
/// so later ownership changes cannot rewrite history.
model ProfitDistribution {
  id                 String                   @id @default(uuid(7)) @db.Uuid
  profitPeriodId     String                   @db.Uuid
  shareholderId      String                   @db.Uuid
  percentageSnapshot Decimal                  @db.Decimal(7, 4)
  allocatedAmount    Decimal                  @db.Decimal(24, 2)
  currency           String                   @default("IRR") @db.VarChar(3)
  status             ProfitDistributionStatus @default(PENDING)
  approvedAt         DateTime?                @db.Timestamptz(3)
  notes              String?                  @db.Text
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)

  profitPeriod ProfitPeriod        @relation(fields: [profitPeriodId], references: [id], onDelete: Restrict)
  shareholder  Shareholder         @relation(fields: [shareholderId], references: [id], onDelete: Restrict)
  payouts      ShareholderPayout[]

  @@unique([profitPeriodId, shareholderId])
  @@index([shareholderId, createdAt])
  @@index([status])
}

/// Service-scoped profit calculation. Revenue is the LIVE payments completed
/// for the service plus income assigned to it, less assigned paid expenses and
/// settled provider fees tied to the service's payments. Allocation uses
/// ServiceOwnershipShare when present, otherwise corporation ownership.
model ServiceProfitPeriod {
  id                  String   @id @default(uuid(7)) @db.Uuid
  serviceId           String   @db.Uuid
  startsOn            DateTime @db.Date
  endsOn              DateTime @db.Date
  currency            String   @default("IRR") @db.VarChar(3)
  grossPayments       Decimal  @db.Decimal(24, 2)
  manualIncome        Decimal  @db.Decimal(24, 2)
  totalExpenses       Decimal  @db.Decimal(24, 2)
  providerFees        Decimal  @db.Decimal(24, 2)
  netProfit           Decimal  @db.Decimal(24, 2)
  distributableAmount Decimal  @db.Decimal(24, 2)
  unallocatedResidual Decimal  @db.Decimal(24, 2)
  ownershipTotal      Decimal  @db.Decimal(7, 4)
  ownershipSource     String   @db.VarChar(20)
  calculatedAt        DateTime @default(now()) @db.Timestamptz(3)
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  service       ConnectedService            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  distributions ServiceProfitDistribution[]

  @@unique([serviceId, startsOn, endsOn])
  @@index([serviceId, endsOn])
}

model ServiceProfitDistribution {
  id                    String   @id @default(uuid(7)) @db.Uuid
  serviceProfitPeriodId String   @db.Uuid
  shareholderId         String   @db.Uuid
  percentageSnapshot    Decimal  @db.Decimal(7, 4)
  allocatedAmount       Decimal  @db.Decimal(24, 2)
  currency              String   @default("IRR") @db.VarChar(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  period      ServiceProfitPeriod @relation(fields: [serviceProfitPeriodId], references: [id], onDelete: Cascade)
  shareholder Shareholder         @relation(fields: [shareholderId], references: [id], onDelete: Restrict)

  @@unique([serviceProfitPeriodId, shareholderId])
  @@index([shareholderId])
}

/// Payments against a distribution. Multiple rows support partial payment.
model ShareholderPayout {
  id                   String       @id @default(uuid(7)) @db.Uuid
  profitDistributionId String       @db.Uuid
  accountId            String?      @db.Uuid
  amount               Decimal      @db.Decimal(24, 2)
  currency             String       @default("IRR") @db.VarChar(3)
  status               PayoutStatus @default(PENDING)
  paidAt               DateTime?    @db.Timestamptz(3)
  externalReference    String?      @db.VarChar(191)
  note                 String?      @db.Text
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  profitDistribution ProfitDistribution @relation(fields: [profitDistributionId], references: [id], onDelete: Restrict)
  account            FinancialAccount?  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([profitDistributionId])
  @@index([profitDistributionId, createdAt])
  @@index([accountId, paidAt])
  @@index([status])
}

/// Append-only audit trail for financially significant changes.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   String   @db.VarChar(80)
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
